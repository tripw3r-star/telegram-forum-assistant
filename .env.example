# ==============================================================================
# НАСТРОЙКИ TELEGRAM-БОТА
# ==============================================================================
# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Числовые Telegram ID администраторов через запятую (для доступа к команде /admin)
# Узнать свой ID можно у бота @userinfobot или @myidbot
ADMIN_IDS=411405875,5837821666,7584052286

# ==============================================================================
# НАСТРОЙКИ OPENAI-COMPATIBLE API (МОДЕЛЬ ИИ)
# ==============================================================================
# Базовый URL API любого OpenAI-совместимого сервиса:
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Groq: https://api.groq.com/openai/v1
# - Локальная Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# API-ключ выбранного провайдера
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Название модели для анализа и классификации:
# Примеры:
# - gpt-4o-mini (для OpenAI)
# - openrouter/free (бесплатный пул OpenRouter)
# - deepseek/deepseek-chat (для OpenRouter или DeepSeek)
OPENAI_MODEL=openrouter/free

# Температура генерации (0.0 - точные ответы, 1.0 - творческие)
OPENAI_TEMPERATURE=0.2

# Лимит токенов на ответ модели
OPENAI_MAX_TOKENS=2000

# ==============================================================================
# ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ
# ==============================================================================
# Имя топика/ветки форума для входящих материалов по умолчанию
DEFAULT_INBOX_TOPIC_NAME=📥 Входящие
